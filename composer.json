{
    "name": "bergstar/chat-field",
    "description": "This is my package chat-field",
    "keywords": [
        "bergstar",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "chat-field"
    ],
    "homepage": "https://github.com/bergstar/chat-field",
    "support": {
        "issues": "https://github.com/bergstar/chat-field/issues",
        "source": "https://github.com/bergstar/chat-field"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Kuzmenko",
            "email": "dmitry@toolborg.no",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Toolborg\\ChatField\\": "src/",
            "Toolborg\\ChatField\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toolborg\\ChatField\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Toolborg\\ChatField\\ChatFieldServiceProvider"
            ],
            "aliases": {
                "ChatField": "Toolborg\\ChatField\\Facades\\ChatField"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}